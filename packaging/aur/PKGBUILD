# Maintainer: Israel Roldan <israel.alberto.rv@gmail.com>
# Submitter:  Bose Connect for Linux team
#
# This PKGBUILD pulls the upstream release tarball and produces an
# Arch package that installs:
#   - /usr/bin/bose-connect-gui (the GTK4 + libadwaita GUI)
#   - /usr/bin/bose-connect-app-linux (the original C-shaped CLI)
#   - /usr/lib/libbose_connect.so (the C ABI)
#   - /usr/share/applications/com.airvzxf.bose-connect-gui.desktop
#   - /usr/share/metainfo/com.airvzxf.bose-connect-gui.metainfo.xml
#   - /usr/share/icons/hicolor/{scalable,symbolic}/apps/...
#   - /usr/share/bash-completion/completions/bose-connect-gui
#
# The binary runs against the user's session D-Bus at runtime, so
# no D-Bus daemon dependency is declared in makedepends.
#
# To test locally:
#   makepkg -si
# To publish to AUR:
#   git push aur master

pkgname=bose-connect-gui
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4 + libadwaita front-end for the bose_connect RFCOMM library"
arch=('x86_64')
url="https://github.com/airvzxf/bose-connect-app-linux"
license=('GPL3')
depends=(
    'glib2'
    'gtk4'
    'libadwaita'
    'libnotify'
)
makedepends=(
    'cargo'
    'rust'
    'git'
    'openssl'   # cargo's TLS backend
)
# The release tarball is generated on GitHub. AUR's `source=()`
# accepts a `https://github.com/.../archive/refs/tags/v…` URL
# with a matching `sha256sums=()` entry below. Keep these in sync
# with the upstream `git tag` workflow.
source=("https://github.com/airvzxf/bose-connect-app-linux/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')   # fill in once the tag is published

# The .SRCINFO is generated by `makepkg --printsrcinfo > .SRCINFO`
# after this file is final. See packaging/aur/.SRCINFO for the
# generated form.

build() {
    cd "${srcdir}/bose-connect-app-linux-${pkgver}"
    cargo build --release --locked \
        --workspace --all-targets \
        --target-dir=target
}

check() {
    cd "${srcdir}/bose-connect-app-linux-${pkgver}"
    cargo test --workspace --lib --release
}

package() {
    cd "${srcdir}/bose-connect-app-linux-${pkgver}"

    install -Dm755 target/release/bose-connect-gui \
        "${pkgdir}/usr/bin/bose-connect-gui"
    install -Dm755 target/release/bose-connect-app-linux \
        "${pkgdir}/usr/bin/bose-connect-app-linux"
    install -Dm755 target/release/bose-connect-probe \
        "${pkgdir}/usr/bin/bose-connect-probe"
    install -Dm644 target/release/libbose_connect.so \
        "${pkgdir}/usr/lib/libbose_connect.so"

    # Desktop entry + AppStream metadata.
    install -Dm644 packaging/linux/bose-connect-gui.desktop \
        "${pkgdir}/usr/share/applications/com.airvzxf.bose-connect-gui.desktop"
    install -Dm644 packaging/linux/com.airvzxf.bose-connect-gui.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/com.airvzxf.bose-connect-gui.metainfo.xml"

    # Icons (KDE/GNOME find the scalable SVG first, then the
    # symbolic for HiDPI variants).
    install -Dm644 \
        crates/bose-connect-gui/resources/icons/hicolor/scalable/apps/bose-connect-gui.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.airvzxf.bose-connect-gui.svg"
    install -Dm644 \
        crates/bose-connect-gui/resources/icons/hicolor/symbolic/apps/bose-connect-gui.svg \
        "${pkgdir}/usr/share/icons/hicolor/symbolic/apps/com.airvzxf.bose-connect-gui-symbolic.svg"

    # Shell completion.
    install -Dm644 packaging/linux/bose-connect-gui.bash-completion \
        "${pkgdir}/usr/share/bash-completion/completions/bose-connect-gui"
}
